name: '🤖 Gemini CLI Assistant'

on:
  issue_comment:
    types: [created]
  pull_request:
    types: [opened, synchronize]

permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  gemini_task:
    if: |
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@gemini-cli')) ||
      github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - name: 'Checkout code'
        uses: actions/checkout@v4

      - name: 'Run Gemini CLI'
        uses: google-github-actions/run-gemini-cli@v0
        with:
          gemini_api_key: '${{ secrets.GEMINI_API_KEY }}'
          prompt: |
            Ты — опытный разработчик, специалист по базам данных.
            Это репозиторий для создания веб-сайта на котором можно будет потренироваться в нормализации БД по 1, 2 и 3 НФ.
            
            Если пользователь в комментарии к Issue или PR пишет "@gemini-cli" и дает задачу — выполни её.
            Если это открытие нового PR — проанализируй код и оставь ревью.
            
            Когда пишешь код, создавай коммиты и открывай Pull Request с изменениями.
            Всегда используй понятные имена для файлов и функций.
